{
  "name": "ple-import-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder -m --publish=never",
    "test:web": "playwright test -c playwright.web.config.js",
    "test:desktop": "playwright test -c playwright.desktop.config.js",
    "test:e2e": "npm run test:web && npm run test:desktop"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "electron": "^40.1.0",
    "electron-builder": "^26.7.0"
  },
  "build": {
    "appId": "com.ple.importprep",
    "productName": "PLE Import Prep",
    "afterPack": "scripts/afterPack.js",
    "files": [
      "**/*"
    ],
    "mac": {
      "target": [
        "zip"
      ],
      "mergeASARs": true,
      "x64ArchFiles": "Contents/Resources/app.asar.unpacked/node_modules/@napi-rs/**",
      "sign": false,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "forceCodeSigning": false
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
